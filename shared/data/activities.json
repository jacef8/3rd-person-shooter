      "fall": 34,
      "fallSpeed": 14,
      "suitFall": 11,
      "suitSpeed": 42,
      "chuteFall": 5.5,
      "chuteSpeed": 9,
      "autoChute": 55
    }
  },
  "respawn": {
    "_about": "Coming back after you die: at your own stash house or any town (the towns with a Contact, plus small named communities such as Rock Bluff). Landing zones and your crew are fast travel from home. You wait waitS, plus perDeathS for each other death in the last streakMin minutes (up to maxWaitS). For keepAwayMin minutes nothing within keepAwayM of where you died is open, except your stash house: no town respawn there and no fast travel there. Joining your crew by fast travel works once every crewEveryMin minutes.",
    "waitS": 10,
    "perDeathS": 20,
    "maxWaitS": 120,
    "streakMin": 10,
    "keepAwayM": 1500,
    "keepAwayMin": 5,
    "crewEveryMin": 5
  },
  "hotZone": {
    "_about": "One hot zone at a time, somewhere random (a named place or open country), at random times: a random gap after the last one closes, a random warning, a random length. Elite guards patrol it; a few big crates and caches scattered through its buildings, ditches and woods. Everything taken is hot: you show on everyone's map (every pingMs carrying crate loot, every cachePingMs carrying only cache loot) until you extract it; die first and it drops. The taxi drops no closer than keepOutM; fast travel and respawns can't land you that close; a hot-drop flare parachutes you to the edge.",
